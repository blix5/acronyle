# Claude API key (https://console.anthropic.com/settings/keys). Used once a day to write the puzzle.
ANTHROPIC_API_KEY=

# Upstash Redis. Vercel's Upstash integration sets the KV_* names automatically;
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN also work.
# Leave empty locally to use an in-memory store (puzzles reset when the dev server restarts).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Any long random string. Vercel sends it as a Bearer token to /api/cron.
CRON_SECRET=
